{
  "description": "Sentinel Claude Code hooks: pre-action gate for paid/state-changing Roboflow MCP calls, verified outcomes, and local ledger write",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cta.js\"",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\cta.js\"",
            "type": "command"
          }
        ],
        "matcher": "^mcp__(plugin_[A-Za-z0-9_-]+_)?roboflow__.*$"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cta.js\"",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\cta.js\"",
            "type": "command"
          }
        ],
        "matcher": "^mcp__(plugin_[A-Za-z0-9_-]+_)?roboflow__.*$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.js\"",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\gate.js\"",
            "type": "command"
          }
        ],
        "matcher": "^mcp__(plugin_[A-Za-z0-9_-]+_)?roboflow__.*$"
      }
    ]
  }
}
