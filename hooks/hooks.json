{
  "description": "Sentinel Codex hook: verified Roboflow MCP outcomes and local ledger write",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${PLUGIN_ROOT}/hooks/cta.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\hooks\\cta.js\"",
            "type": "command"
          }
        ],
        "matcher": "mcp__(plugin_[A-Za-z0-9_-]+_)?roboflow__"
      }
    ]
  }
}
